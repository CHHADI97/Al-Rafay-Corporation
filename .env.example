# ---------------------------------------------------------------------------
# Al Rafay Corporation & Traders — environment configuration
# Copy this file to `.env` and fill in the values you need.
# Without any Supabase values the site runs in DEMO mode from `seed/*.json`
# with a password-only admin login (password: DEMO_ADMIN_PASSWORD).
# ---------------------------------------------------------------------------

# --- server ----------------------------------------------------------------
# PORT=4173                     # port the website listens on
# DATA_DIR=./storage            # folder for the offline demo store and uploads
# SITE_URL=https://example.com  # public origin used for canonical URLs + sitemap

# --- database, Google login and image storage (Supabase) -------------------
# Project → Settings → API in the Supabase dashboard.
# The anon key is safe to expose; the service-role key is optional and only
# needed when you want the server to bypass Row Level Security.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=                    # optional, keep secret
# SUPABASE_BUCKET=car-images                    # Storage bucket for photo uploads

# --- admin panel -----------------------------------------------------------
# The single Gmail address allowed into /admin. Can also be changed later from
# the dashboard (Settings → Admin email).
# ADMIN_EMAIL=abdulhadicreates@gmail.com
# SESSION_SECRET=change-me-to-a-long-random-string
# DEMO_ADMIN_PASSWORD=alrafay123                # demo-mode login only

# --- optional tweaks -------------------------------------------------------
# MAP_FRAME_SOURCES=https://www.google.com https://maps.google.com https://www.google.com/maps
# FRAME_ANCESTORS=                              # extra origins allowed to iframe the
#                                               # site (leave empty in production)
