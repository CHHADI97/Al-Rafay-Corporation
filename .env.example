# ---------------------------------------------------------------------------
# Alraffay Corporation & Traders — optional configuration.
# Copy this file to `.env` and fill in what you need. Every value is optional:
# the site runs with no configuration at all (local JSON storage + password).
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
PORT=4173
HOST=0.0.0.0
# DATA_DIR=./storage

# --- Google sign-in for the admin panel (recommended) -----------------------
# Create an OAuth 2.0 "Web application" client at https://console.cloud.google.com
# Authorised JavaScript origin: https://your-domain.com  (and http://localhost:4173 while testing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail addresses allowed to open /admin. Comma separated.
# You can also manage this list inside the dashboard (Admin → Access).
ADMIN_EMAILS=

# --- Supabase (database + photo storage) ------------------------------------
# Leave empty to keep everything in local files. See docs/SUPABASE.md.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=alraffay-media
# SUPABASE_TABLE=rafay_documents

# --- Security ---------------------------------------------------------------
# Set to "false" only if you run the site behind plain HTTP on a private network.
# COOKIE_SECURE=auto
