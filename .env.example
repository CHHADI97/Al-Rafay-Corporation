# Optional: provision the owner's first dashboard login with your own strong password (12+ characters).
# Leave unset to generate a one-time, random password in the server startup logs.
# ADMIN_PASSWORD=replace-with-a-long-random-password
# PORT=4173
# DATA_DIR=./storage
# Set to true ONLY when the app sits behind a trusted reverse proxy (nginx, Caddy, a platform load balancer)
# that sets X-Forwarded-For. Otherwise leave unset so client headers cannot spoof rate-limit addresses.
# TRUST_PROXY=true
