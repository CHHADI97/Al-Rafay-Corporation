{
  "name": "al-rafay-corporation",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Al Rafay Corporation & Traders — new & used car dealership website (Islamabad) with a Supabase powered admin panel.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node tools/seed.mjs",
    "prepare-images": "node tools/prepare-images.mjs",
    "check": "node tools/check.mjs",
    "build:pages": "node tools/build-pages.mjs",
    "icons": "node tools/make-icons.mjs",
    "check:browser": "node tools/browser-check.mjs",
    "check:admin": "node tools/admin-check.mjs",
    "check:all": "node tools/check.mjs && node tools/browser-check.mjs && node tools/admin-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "compression": "^1.8.2",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "multer": "^2.4.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
